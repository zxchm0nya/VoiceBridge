<Window x:Class="VoiceBridge.Installer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VoiceBridge Setup"
        Width="500" Height="380"
        MinWidth="500" MinHeight="380"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Step 1: Welcome -->
        <StackPanel x:Name="StepWelcome" Grid.Row="0">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <Image Source="Assets/app.ico" Width="32" Height="32" Margin="0,0,12,0"
                       VerticalAlignment="Center" />
                <TextBlock Text="VoiceBridge Installer" FontSize="18" FontWeight="Bold"
                           VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock x:Name="StepWelcomeText" Text="This wizard will install VoiceBridge on your computer." TextWrapping="Wrap" />
            <TextBlock Text="Click Next to continue." Margin="0,12,0,0" />
        </StackPanel>

        <!-- Step 2: Path -->
        <StackPanel x:Name="StepPath" Grid.Row="0" Visibility="Collapsed">
            <TextBlock Text="Install Location" FontSize="18" FontWeight="Bold" Margin="0,0,0,10" />
            <TextBlock Text="Choose the folder where VoiceBridge will be installed:" Margin="0,0,0,8" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="InstallPath" Text="C:\Program Files\VoiceBridge" Height="28" VerticalContentAlignment="Center" Padding="4,2" />
                <Button Grid.Column="1" Content="Browse..." Margin="8,0,0,0" Width="75" Height="28" Click="Browse_Click" />
            </Grid>
            <CheckBox x:Name="ChkDesktopShortcut" Content="Create desktop shortcut" IsChecked="True" Margin="0,12,0,0" />
            <CheckBox x:Name="LaunchAfter" Content="Launch VoiceBridge after installation" IsChecked="True" Margin="0,6,0,0" />
        </StackPanel>

        <!-- Step 3: Dependencies (only when the virtual cable is missing) -->
        <StackPanel x:Name="StepDeps" Grid.Row="0" Visibility="Collapsed">
            <TextBlock Text="Missing dependency" FontSize="18" FontWeight="Bold" Margin="0,0,0,10" />
            <TextBlock x:Name="DepsText"
                       Text="Virtual audio cable (VB-Cable) is not installed. VoiceBridge cannot work without it: there is nowhere to send the sound."
                       TextWrapping="Wrap" Margin="0,0,0,10" />
            <TextBlock x:Name="DepsHint"
                       Text="Click Install to download the official VB-Cable setup and follow its window, or uncheck the box to skip it."
                       TextWrapping="Wrap" Margin="0,0,0,12" />
            <CheckBox x:Name="ChkInstallCable" Content="Download and install VB-Cable now" IsChecked="True"
                      Checked="CableChk_Changed" Unchecked="CableChk_Changed" />
            <TextBlock x:Name="DepsWarning" Visibility="Collapsed" TextWrapping="Wrap" Margin="0,12,0,0"
                       Text="Without a virtual cable VoiceBridge will show a warning at every launch and will not be able to work." />
        </StackPanel>

        <!-- Step 4: Progress -->
        <StackPanel x:Name="StepProgress" Grid.Row="0" Visibility="Collapsed">
            <TextBlock Text="Installing..." FontSize="18" FontWeight="Bold" Margin="0,0,0,10" />
            <TextBlock x:Name="ProgressText" Text="Preparing..." Margin="0,0,0,12" />
            <ProgressBar x:Name="InstallProgress" Height="20" Minimum="0" Maximum="100" />
        </StackPanel>

        <!-- Step 5: Done -->
        <StackPanel x:Name="StepDone" Grid.Row="0" Visibility="Collapsed">
            <TextBlock Text="Installation Complete" FontSize="18" FontWeight="Bold" Margin="0,0,0,10" />
            <TextBlock x:Name="DoneSub" Text="VoiceBridge has been installed successfully." TextWrapping="Wrap" />
        </StackPanel>

        <!-- Footer buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="BtnBack" Content="Back" Width="80" Height="30" Margin="0,0,8,0"
                    Visibility="Collapsed" Click="Back_Click" />
            <Button x:Name="BtnCancel" Content="Cancel" Width="80" Height="30" Margin="0,0,8,0"
                    Click="Cancel_Click" />
            <Button x:Name="BtnNext" Content="Next" Width="80" Height="30" IsDefault="True"
                    Click="Next_Click" />
        </StackPanel>
    </Grid>
</Window>

<Window x:Class="VoiceBridge.Installer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VoiceBridge Setup"
        Width="520" Height="400"
        MinWidth="520" MinHeight="400"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{DynamicResource BgDeepBrush}"
        FontFamily="{StaticResource AppFont}"
        Icon="Assets/app.ico">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Шаг 1: приветствие -->
        <StackPanel x:Name="StepWelcome" Grid.Row="0">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <Image Source="Assets/app.ico" Width="34" Height="34" Margin="0,0,12,0"
                       VerticalAlignment="Center" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="VoiceBridge" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="наушники → микрофон" FontSize="11.5" Margin="0,2,0,0"
                               Foreground="{DynamicResource TextMutedBrush}" />
                </StackPanel>
            </StackPanel>
            <TextBlock Text="Мастер установит VoiceBridge на ваш компьютер."
                       Style="{StaticResource SubText}" TextWrapping="Wrap" />
            <TextBlock Text="Нажмите «Далее», чтобы продолжить." Margin="0,12,0,0"
                       Style="{StaticResource SubText}" />
        </StackPanel>

        <!-- Шаг 2: путь -->
        <StackPanel x:Name="StepPath" Grid.Row="0" Visibility="Collapsed">
            <TextBlock Text="Папка установки" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10" />
            <TextBlock Text="Выберите папку, в которую будет установлен VoiceBridge:"
                       Style="{StaticResource SubText}" Margin="0,0,0,8" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="InstallPath" Height="30" VerticalContentAlignment="Center"
                         Padding="6,3" Background="{DynamicResource BgElevatedBrush}"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         BorderBrush="{DynamicResource BorderBrush}" />
                <Button Grid.Column="1" Content="Обзор..." Margin="8,0,0,0" Width="80" Height="30"
                        Style="{StaticResource SecondaryButton}" Click="Browse_Click" />
            </Grid>
            <CheckBox x:Name="ChkDesktopShortcut" Content="Создать ярлык на рабочем столе"
                      IsChecked="True" Margin="0,14,0,0" />
            <CheckBox x:Name="LaunchAfter" Content="Запустить VoiceBridge после установки"
                      IsChecked="True" Margin="0,7,0,0" />
        </StackPanel>

        <!-- Шаг 3: прогресс -->
        <StackPanel x:Name="StepProgress" Grid.Row="0" Visibility="Collapsed">
            <TextBlock Text="Установка..." FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10" />
            <TextBlock x:Name="ProgressText" Text="Подготовка..." Style="{StaticResource SubText}"
                       Margin="0,0,0,14" />
            <ProgressBar x:Name="InstallProgress" Height="18" Minimum="0" Maximum="100" />
        </StackPanel>

        <!-- Шаг 4: готово -->
        <StackPanel x:Name="StepDone" Grid.Row="0" Visibility="Collapsed">
            <TextBlock Text="Установка завершена" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10" />
            <TextBlock x:Name="DoneSub" Text="VoiceBridge успешно установлен." Style="{StaticResource SubText}"
                       TextWrapping="Wrap" />
        </StackPanel>

        <!-- Кнопки -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="BtnBack" Content="Назад" Width="86" Height="32" Margin="0,0,8,0"
                    Visibility="Collapsed" Style="{StaticResource SecondaryButton}"
                    Click="Back_Click" />
            <Button x:Name="BtnCancel" Content="Отмена" Width="86" Height="32" Margin="0,0,8,0"
                    Style="{StaticResource SecondaryButton}" Click="Cancel_Click" />
            <Button x:Name="BtnNext" Content="Далее" Width="86" Height="32" IsDefault="True"
                    Style="{StaticResource PrimaryButton}" Click="Next_Click" />
        </StackPanel>
    </Grid>
</Window>

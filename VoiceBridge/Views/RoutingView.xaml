<UserControl x:Class="VoiceBridge.Views.RoutingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <StackPanel>

            <!-- Уведомление / ошибка -->
            <Border x:Name="Notice" CornerRadius="12" Padding="14,10" Margin="0,0,0,12"
                    Visibility="Collapsed"
                    Background="{DynamicResource BgElevatedBrush}"
                    BorderBrush="{DynamicResource DangerBrush}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="NoticeIcon" Text="&#xE711;" FontFamily="Segoe MDL2 Assets"
                               FontSize="14" Margin="0,1,10,0"
                               Foreground="{DynamicResource DangerBrush}" />
                    <TextBlock x:Name="NoticeText" Grid.Column="1" Style="{StaticResource SubText}"
                               TextWrapping="Wrap" />
                </Grid>
            </Border>

            <!-- ===== Маршрут аудио ===== -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="Маршрут аудио" />
                    <TextBlock Style="{StaticResource SubText}" Margin="0,6,0,14" TextWrapping="Wrap"
                               Text="Программа слушает звук в наушниках через захват loopback — воспроизведение при этом не нарушается, вы по-прежнему всё слышите. Пойманный звук параллельно отправляется в виртуальный кабель, который Discord использует как микрофон." />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Слушать (вывод системы)" />
                            <ComboBox x:Name="CmbSource" Style="{StaticResource AppComboBox}"
                                      DisplayMemberPath="DisplayName"
                                      SelectionChanged="Route_SelectionChanged" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Выводить в (микрофон)" />
                            <ComboBox x:Name="CmbTarget" Style="{StaticResource AppComboBox}"
                                      DisplayMemberPath="DisplayName"
                                      SelectionChanged="Route_SelectionChanged" />
                        </StackPanel>
                    </Grid>

                    <TextBlock x:Name="TargetHint" Style="{StaticResource MutedText}"
                               Margin="0,8,0,0" TextWrapping="Wrap" />

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Захватывать окно (приложение)" />
                            <ComboBox x:Name="CmbApp" Style="{StaticResource AppComboBox}"
                                      DisplayMemberPath="DisplayName"
                                      DropDownOpened="CmbApp_DropDownOpened"
                                      SelectionChanged="Route_SelectionChanged" />
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource SecondaryButton}"
                                Content="⟳" Width="36" Margin="10,0,0,0" VerticalAlignment="Bottom"
                                ToolTip="Обновить список окон" Click="BtnRefreshApp_Click" />
                    </Grid>
                    <TextBlock x:Name="AppHint" Style="{StaticResource MutedText}"
                               Margin="0,7,0,0" TextWrapping="Wrap" />

                    <Border x:Name="AppListPanel" Style="{StaticResource InnerBox}"
                            Margin="0,10,0,0" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Style="{StaticResource FieldLabel}"
                                       Text="Приложения → Discord" />
                            <ItemsControl x:Name="AppChecks" Margin="0,6,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                            <ToggleButton Style="{StaticResource ToggleSwitch}"
                                                          IsChecked="{Binding Passed, Mode=OneWay}"
                                                          Click="AppTgl_Click" />
                                            <TextBlock Text="{Binding Name}" FontSize="12.5"
                                                       Margin="12,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Style="{StaticResource MutedText}" Margin="0,8,0,0"
                                       TextWrapping="Wrap"
                                       Text="Галка — звук приложения уходит в Discord. Снимите галку — приложение замолчит для Discord, ваш голос через микс продолжит идти." />
                        </StackPanel>
                    </Border>

                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Button x:Name="BtnStart" Style="{StaticResource PrimaryButton}"
                                MinWidth="160" Content="▶   Запустить" Click="BtnStart_Click" />
                        <Button x:Name="BtnRefresh" Style="{StaticResource SecondaryButton}"
                                Content="Обновить устройства" Margin="10,0,0,0" Click="BtnRefresh_Click" />
                        <Button x:Name="BtnMute" Style="{StaticResource SecondaryButton}"
                                Content="Заглушить" Margin="10,0,0,0" IsEnabled="False"
                                Click="BtnMute_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ===== Уровень сигнала ===== -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <Grid Margin="0,0,0,14">
                        <TextBlock Style="{StaticResource SectionTitle}" Text="Уровень сигнала"
                                   VerticalAlignment="Center" />
                        <Border x:Name="StatePill" Style="{StaticResource Badge}"
                                HorizontalAlignment="Right" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="StateDot" Width="8" Height="8" Fill="#6B7690"
                                         Margin="0,0,7,0" VerticalAlignment="Center" />
                                <TextBlock x:Name="StateText" Text="Остановлено" FontSize="12"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Grid Margin="0,0,0,6">
                        <TextBlock Text="Наушники" FontSize="12.5"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock x:Name="LblSysPeak" Style="{StaticResource AccentText}"
                                   HorizontalAlignment="Right" Text="−∞ дБ" />
                    </Grid>
                    <Border x:Name="MeterSysTrack" Height="10" CornerRadius="5" ClipToBounds="True"
                            Background="{DynamicResource BgElevatedBrush}" Margin="0,0,0,12">
                        <Border x:Name="MeterSys" Height="10" Width="0" HorizontalAlignment="Left">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#28D7B7" Offset="0" />
                                    <GradientStop Color="#61A8FF" Offset="0.65" />
                                    <GradientStop Color="#34D399" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                    </Border>

                    <Grid Margin="0,0,0,6" x:Name="MicMeterRow"
                          Visibility="{Binding IsChecked, ElementName=TglMicMix, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Микрофон" FontSize="12.5"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock x:Name="LblMicPeak" Style="{StaticResource AccentText}"
                                   HorizontalAlignment="Right" Text="−∞ дБ" />
                    </Grid>
                    <Border x:Name="MeterMicTrack" Height="10" CornerRadius="5" ClipToBounds="True"
                            Background="{DynamicResource BgElevatedBrush}" Margin="0,0,0,12"
                            Visibility="{Binding IsChecked, ElementName=TglMicMix, Converter={StaticResource BoolToVis}}">
                        <Border x:Name="MeterMic" Height="10" Width="0" HorizontalAlignment="Left">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#28D7B7" Offset="0" />
                                    <GradientStop Color="#61A8FF" Offset="0.65" />
                                    <GradientStop Color="#34D399" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                    </Border>

                    <Grid Margin="0,0,0,6">
                        <TextBlock Text="В микрофон (итог)" FontSize="12.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock x:Name="LblOutPeak" Style="{StaticResource AccentText}"
                                   HorizontalAlignment="Right" Text="−∞ дБ" />
                    </Grid>
                    <Border x:Name="MeterOutTrack" Height="10" CornerRadius="5" ClipToBounds="True"
                            Background="{DynamicResource BgElevatedBrush}">
                        <Border x:Name="MeterOut" Height="10" Width="0" HorizontalAlignment="Left">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#28D7B7" Offset="0" />
                                    <GradientStop Color="#61A8FF" Offset="0.65" />
                                    <GradientStop Color="#34D399" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                    </Border>

                    <TextBlock x:Name="FmtInfo" Style="{StaticResource MutedText}" Margin="0,10,0,0"
                               Text="" />
                </StackPanel>
            </Border>

            <!-- ===== Громкость и микс ===== -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="Громкость и микс" />

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <Grid>
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Усиление системы" />
                                <TextBlock x:Name="LblGain" Style="{StaticResource AccentText}"
                                           HorizontalAlignment="Right" Text="100%" />
                            </Grid>
                            <Slider x:Name="SldGain" Style="{StaticResource AppSlider}"
                                    Minimum="0" Maximum="200" Value="100"
                                    ValueChanged="SldGain_ValueChanged" />
                        </StackPanel>

                        <StackPanel Grid.Column="2"
                                    Visibility="{Binding IsChecked, ElementName=TglMicMix, Converter={StaticResource BoolToVis}}">
                            <Grid>
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Усиление микрофона" />
                                <TextBlock x:Name="LblMicGain" Style="{StaticResource AccentText}"
                                           HorizontalAlignment="Right" Text="100%" />
                            </Grid>
                            <Slider x:Name="SldMicGain" Style="{StaticResource AppSlider}"
                                    Minimum="0" Maximum="200" Value="100"
                                    ValueChanged="SldMicGain_ValueChanged" />
                        </StackPanel>
                    </Grid>

                    <Border Style="{StaticResource InnerBox}" Margin="0,16,0,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <ToggleButton x:Name="TglMicMix" Style="{StaticResource ToggleSwitch}"
                                              Click="TglMicMix_Click" />
                                <TextBlock Text="Микшать свой микрофон" FontSize="13" FontWeight="SemiBold"
                                           Margin="12,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource MutedText}" Margin="0,7,0,0" TextWrapping="Wrap"
                                       Text="Если включить, к звуку из наушников добавится ваш голос — собеседник услышит и системный звук, и вас." />
                            <StackPanel Margin="0,12,0,0"
                                        Visibility="{Binding IsChecked, ElementName=TglMicMix, Converter={StaticResource BoolToVis}}">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Микрофон для микса" />
                                <ComboBox x:Name="CmbMic" Style="{StaticResource AppComboBox}"
                                          DisplayMemberPath="DisplayName"
                                          SelectionChanged="Route_SelectionChanged" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

        </StackPanel>
</UserControl>
